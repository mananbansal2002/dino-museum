{
  "name": "dino-museum",
  "version": "1.0.0",
  "description": "A multiplayer 3D dinosaur museum tour you can walk around with friends.",
  "type": "module",
  "private": true,
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "journey": "node scripts/journey.mjs",
    "test": "npm run check && npm run smoke",
    "deploy": "vercel --prod"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "5.3.0",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "socket.io-client": "4.8.4",
    "three": "0.160.0"
  }
}
